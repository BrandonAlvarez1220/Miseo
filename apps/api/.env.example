ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://miseo:miseo@localhost:5432/miseo
# Set to true when connecting through Supabase's transaction pooler (port 6543).
DATABASE_DISABLE_PREPARED_STATEMENTS=false
CORS_ORIGINS=http://localhost:3000
# Supabase Auth (see docs/AUTH.md). Configure ONE of the two; without them the API
# serves public endpoints and answers 503 on protected ones.
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_ISSUER=https://<project>.supabase.co/auth/v1
# Used only by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://miseo:miseo@localhost:5432/miseo_test

# LOCAL DEVELOPMENT ONLY: sign in without Supabase (see docs/AUTH.md). The app
# refuses to start with DEV_LOGIN_ENABLED=true in production.
DEV_LOGIN_ENABLED=true
DEV_ADMIN_EMAILS=admin@example.com
SUPABASE_JWT_SECRET=local-dev-secret-change-me-at-least-32-bytes
