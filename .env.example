# Root environment for docker compose. Copy to .env.
POSTGRES_USER=miseo
POSTGRES_PASSWORD=miseo
POSTGRES_DB=miseo
CORS_ORIGINS=http://localhost:3000

# Supabase (Phase 3). The service role key is backend-only: never prefix it
# with NEXT_PUBLIC_ and never send it to the browser.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional LLM providers for AI ingestion (Phase 4). The app works without them.
# OLLAMA_BASE_URL=http://localhost:11434
